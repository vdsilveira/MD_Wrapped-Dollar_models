// WDollar Shielded — NativeShieldedToken + Ownable + Pausable
// Tokens são UTXOs shieldeds (privados), sem balanceOf/transfer/approve.

pragma language_version >= 0.23.0;

import CompactStandardLibrary;
import "../node_modules/@openzeppelin/compact-contracts/security/Pausable"
  prefix Pausable_;
import "../node_modules/@openzeppelin/compact-contracts/access/Ownable"
  prefix Ownable_;
import "../../compact-contracts/contracts/src/token/NativeShieldedToken"
  prefix Shielded_;

constructor(
  domainSep: Bytes<32>,
  _name: Opaque<"string">,
  _symbol: Opaque<"string">,
  _decimals: Uint<8>,
  _initOwner: Either<Bytes<32>, ContractAddress>,
) {
  Shielded_initialize(domainSep, _name, _symbol, _decimals);
  Ownable_initialize(_initOwner);
}

/** INativeShieldedToken */

export circuit isInitialized(): Boolean {
  return Shielded_isInitialized();
}

export circuit name(): Opaque<"string"> {
  return Shielded_name();
}

export circuit symbol(): Opaque<"string"> {
  return Shielded_symbol();
}

export circuit decimals(): Uint<8> {
  return Shielded_decimals();
}

export circuit tokenColor(): Bytes<32> {
  return Shielded_tokenColor();
}

export circuit mint(
  recipient: Either<ZswapCoinPublicKey, ContractAddress>,
  amount: Uint<64>,
  nonce: Bytes<32>
): ShieldedCoinInfo {
  Pausable_assertNotPaused();
  Ownable_assertOnlyOwner();
  return Shielded__mint(recipient, amount, nonce);
}

/** IOwnable */

export circuit owner(): Either<Bytes<32>, ContractAddress> {
  return Ownable_owner();
}

export circuit transferOwnership(newOwner: Either<Bytes<32>, ContractAddress>): [] {
  return Ownable_transferOwnership(newOwner);
}

/** IPausable */

export circuit pause(): [] {
  Ownable_assertOnlyOwner();
  Pausable__pause();
}

export circuit unpause(): [] {
  Ownable_assertOnlyOwner();
  Pausable__unpause();
}
