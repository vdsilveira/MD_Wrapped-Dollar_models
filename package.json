{
  "name": "deploytest",
  "version": "1.0.0",
  "type": "module",
  "description": "A Midnight Network application created with create-mn-app",
  "author": "",
  "license": "MIT",
  "scripts": {
    "compile": "compact compile contracts/wdollar.compact contracts/managed/wdollar",
    "compile:shielded": "compact compile contracts/wdollar-shielded.compact contracts/managed/wdollar-shielded",
    "compile:agent": "compact compile contracts/wdollar-agent.compact contracts/managed/wdollar-agent",
    "compile:agent-shielded": "compact compile contracts/wdollar-agent-shielded.compact contracts/managed/wdollar-agent-shielded",
    "deploy:agent-shielded": "npx tsx src/deploy-agent-shielded.ts",
    "deploy:proofstation": "npx tsx src/deploy-with-proofstation.ts",
    "cli:proofstation": "npx tsx src/cli-proofstation.ts",
    "cli:agent-shielded": "npx tsx src/cli-agent-shielded.ts",
    "build": "npx tsc --noEmit || true",
    "setup": "npx tsx src/setup.ts",
    "setup:agent-shielded": "npx tsx src/setup.ts --agent-shielded",
    "deploy": "npx tsx src/deploy.ts",
    "deploy:shielded": "npx tsx src/deploy-shielded.ts",
    "deploy:agent": "npx tsx src/deploy-agent.ts",
    "cli": "npx tsx src/cli.ts",
    "cli:shielded": "npx tsx src/cli-shielded.ts",
    "cli:agent": "npx tsx src/cli-agent.ts",
    "check-balance": "npx tsx src/check-balance.ts",
    "network": "npx tsx src/network.ts",
    "proof-server:start": "docker compose up -d",
    "proof-server:stop": "docker compose down",
    "clean": "rm -rf contracts/managed .midnight-state.json .midnight-wallet-state",
    "test": "echo \"Error: no test specified\" && exit 1",
    "test:e2e": "tsx scripts/e2e-check.ts"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-js": "2.5.0",
    "@midnight-ntwrk/compact-runtime": "0.16.0",
    "@midnight-ntwrk/ledger-v8": "8.0.3",
    "@midnight-ntwrk/midnight-js-contracts": "4.0.4",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.0.4",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.0.4",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "4.0.4",
    "@midnight-ntwrk/midnight-js-network-id": "4.0.4",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "4.0.4",
    "@midnight-ntwrk/midnight-js-types": "4.0.4",
    "@midnight-ntwrk/midnight-js-utils": "4.0.4",
    "@midnight-ntwrk/wallet-sdk-dust-wallet": "3.0.0",
    "@midnight-ntwrk/wallet-sdk-facade": "3.0.0",
    "@midnight-ntwrk/wallet-sdk-hd": "3.0.1",
    "@midnight-ntwrk/wallet-sdk-shielded": "2.1.0",
    "@midnight-ntwrk/wallet-sdk-unshielded-wallet": "2.1.0",
    "@openzeppelin/compact-contracts": "^0.2.0",
    "dotenv": "^17.4.2",
    "rxjs": "^7.8.2",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "midnight",
    "blockchain",
    "zero-knowledge",
    "privacy"
  ]
}
